# .NET
bin/
obj/
*.user
.vs/
artifacts/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Env & secrets — NEVER commit
.env
.env.*
# Templates are documentation, not secrets — the runbook's first step copies this file.
!.env.prod.example
!.env.example
*.pem
*.key
*.pfx
# Root-anchored so it ignores a local `secrets/` data dir WITHOUT catching the
# source folder packages/infrastructure/Secrets/ (case-insensitive match on Windows/macOS).
/secrets/
/vault-data/

# Local-mode SQLite database + file secret store (persisted demo data / credentials)
*.db
*.db-shm
*.db-wal
desk-local-secrets.json

# Docker volumes
infrastructure/docker/volumes/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Test output
coverage/
# ...but that pattern is unanchored, so it also swallowed a page ROUTE named "coverage".
# The rule is meant for test-coverage output, not for source. Re-include the app directory.
!apps/web/src/app/**/coverage/
TestResults/
*.trx
desk-local-files/

# Python bytecode (docs/qa generator)
__pycache__/
*.pyc

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/.playwright/
