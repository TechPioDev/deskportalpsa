# Off-site copy of the nightly Desk Portal backup (read by backup-vps.sh).
#
# Install on the VPS as root, then fill in the values ON THE SERVER (never in chat or git):
#   mkdir -p /etc/deskportal
#   cp /opt/deskportal/infrastructure/scripts/offsite.env.example /etc/deskportal/offsite.env
#   chmod 600 /etc/deskportal/offsite.env
#   nano /etc/deskportal/offsite.env
#   /usr/local/sbin/deskportal-backup        # one run now; look for "off-site ok"
#
# Any S3-compatible bucket works. Use a key that can write to this ONE bucket only, and turn on the
# provider's object lock / versioning if offered, so a stolen server key cannot erase the copies.
#
#   Backblaze B2   OFFSITE_S3_ENDPOINT=https://s3.<region>.backblazeb2.com   (shown on the bucket page)
#   Wasabi         OFFSITE_S3_ENDPOINT=https://s3.<region>.wasabisys.com
#   AWS S3         OFFSITE_S3_ENDPOINT=https://s3.<region>.amazonaws.com
#   Cloudflare R2  OFFSITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  (region: auto)

OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_BUCKET=
OFFSITE_S3_PREFIX=deskportal
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=

# Encrypts every file before it leaves the server. At least 20 characters. STORE IT IN YOUR PASSWORD
# MANAGER TOO: without it the off-site copies cannot be opened, and this server is the thing they
# exist to replace. Generate one with:  openssl rand -base64 32
OFFSITE_PASSPHRASE=

# Copies older than this are deleted from the bucket.
OFFSITE_KEEP_DAYS=30
